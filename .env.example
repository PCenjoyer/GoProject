HOOKFORGE_HTTP_ADDR=:8080
HOOKFORGE_DIAGNOSTICS_ADDR=:9090
HOOKFORGE_DATABASE_URL=postgres://hookforge:REPLACE_ME@localhost:5432/hookforge?sslmode=disable
HOOKFORGE_POSTGRES_PASSWORD=REPLACE_ME
HOOKFORGE_GRAFANA_ADMIN_PASSWORD=REPLACE_ME
HOOKFORGE_SECRET_ENCRYPTION_KEY=REPLACE_WITH_GENERATED_KEY
HOOKFORGE_BOOTSTRAP_API_KEY=REPLACE_WITH_GENERATED_API_KEY
HOOKFORGE_BOOTSTRAP_TENANT_SLUG=default
HOOKFORGE_BOOTSTRAP_TENANT_NAME="Основная организация"
HOOKFORGE_ALLOW_PRIVATE_ENDPOINTS=false
HOOKFORGE_DATABASE_MAX_CONNS=20
HOOKFORGE_SHUTDOWN_TIMEOUT=15s
HOOKFORGE_LOG_LEVEL=info
HOOKFORGE_WORKER_COUNT=16
HOOKFORGE_POLL_INTERVAL=250ms
HOOKFORGE_DELIVERY_TIMEOUT=10s
HOOKFORGE_MAX_ATTEMPTS=8
HOOKFORGE_ENDPOINT_CONCURRENCY=2
